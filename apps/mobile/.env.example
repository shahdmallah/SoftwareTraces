EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-username/your-style-id
EXPO_PUBLIC_API_PORT=3001
# Optional override. Leave blank to auto-detect your laptop IP from Expo during development.
EXPO_PUBLIC_API_URL=
# Optional species backend override. Defaults to the same host as EXPO_PUBLIC_API_URL on port 8000.
EXPO_PUBLIC_WILDLIFE_API_URL=
