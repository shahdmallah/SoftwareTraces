EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-username/your-style-id
EXPO_PUBLIC_API_PORT=3001
EXPO_PUBLIC_WILDLIFE_API_PORT=8000
