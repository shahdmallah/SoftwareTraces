{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@traces/shared-types": ["packages/shared-types/src"],
      "@traces/shared-types/*": ["packages/shared-types/src/*"],
      "@traces/ui": ["packages/ui/src"],
      "@traces/ui/*": ["packages/ui/src/*"]
    }
  }
}
